    { "from": "policy.R_cancel_before_deadline", "to": "common.P_cancel_free_window", "kind": "param_of" },
    { "from": "policy.R_cancel_before_deadline", "to": "billing.D_late_cancel_fee", "kind": "calls" },
    { "from": "policy.R_cancel_before_deadline", "to": "billing.InvoiceLine", "kind": "writes" },
    { "from": "policy.R_cancel_before_deadline", "to": "billing.Invoice", "kind": "reads" },
    { "from": "policy.R_cancel_before_deadline", "to": "identity.C_waive_charge", "kind": "overridden_by" },
    { "from": "policy.R_cancel_before_deadline", "to": "reservation.F_cancel_reservation", "kind": "constrains" },
    { "from": "policy.R_cancel_before_deadline", "to": "policy.E_LATE_CANCELLATION", "kind": "raises" },

    { "from": "policy.R_reservation_within_service_window", "to": "reservation.Reservation", "kind": "constrains" },
    { "from": "policy.R_reservation_within_service_window", "to": "billing.Subscription", "kind": "reads" },
    { "from": "policy.R_reservation_within_service_window", "to": "billing.Subscription", "kind": "rechecks" },
    { "from": "policy.R_reservation_within_service_window", "to": "billing.F_cancel_subscription", "kind": "applies_to", "derived": true },

    { "from": "billing.D_late_cancel_fee", "to": "common.P_late_cancel_rate", "kind": "param_of" },
    { "from": "billing.D_late_cancel_fee", "to": "common.P_money_rounding", "kind": "param_of" },

    { "from": "reservation.F_create_reservation", "to": "identity.C_reserve", "kind": "uses_capability" },
    { "from": "reservation.F_create_reservation", "to": "reservation.Reservation", "kind": "writes", "derived": true },
    { "from": "reservation.F_create_reservation", "to": "catalog.Room", "kind": "reads", "derived": true },
    { "from": "reservation.F_create_reservation", "to": "reservation.Ev_reservation_created", "kind": "emits" }
  ],

  "indexes": {
    "rules_by_feature": {
      "reservation.F_create_reservation": {
        "guard": [],
        "precondition": [
          "identity.R_actor_must_be_active",
          "reservation.R_reservation_not_in_past",
          "reservation.R_room_must_be_bookable",
          "policy.R_reservation_requires_active_subscription"
        ],
        "invariant": [
          "reservation.R_reservation_period_valid",
          "reservation.R_no_double_booking",
          "policy.R_reservation_within_service_window",
          "policy.R_plan_quota_active_reservations",
          "policy.R_plan_advance_limit"
        ],
        "postcondition": []
      },
      "reservation.F_cancel_reservation": {
        "guard": [],
        "precondition": [
          "identity.R_actor_must_be_active",
          "policy.R_cancel_before_deadline"
        ],
        "invariant": [
          "reservation.R_reservation_period_valid",
          "reservation.R_no_double_booking",
          "policy.R_reservation_within_service_window",
          "policy.R_plan_quota_active_reservations",
          "policy.R_plan_advance_limit",
          "billing.R_line_only_on_open_invoice"
        ],
        "postcondition": []
      },
      "billing.F_cancel_subscription": {
        "guard": [],
        "precondition": ["identity.R_actor_must_be_active"],
        "invariant": [
          "billing.R_subscription_period_non_empty",
          "policy.R_reservation_within_service_window",
          "policy.R_plan_quota_active_reservations",
          "policy.R_plan_advance_limit"
        ],
        "postcondition": []
      }
    },

    "recheck_index": {
      "billing.Subscription": [
        { "rule": "policy.R_reservation_within_service_window", "bind": "s", "selector": { "n": "compr", "var": "r", "src": { "n": "ref", "id": "reservation.Reservation" }, "where": null, "body": { "n": "path", "base": "r", "segs": [] } } },
        { "rule": "policy.R_plan_quota_active_reservations", "bind": "s", "selector": { "n": "compr", "var": "r", "src": { "n": "ref", "id": "reservation.Reservation" }, "where": null, "body": { "n": "path", "base": "r", "segs": [] } } },
        { "rule": "policy.R_plan_advance_limit", "bind": "s", "selector": { "n": "compr", "var": "r", "src": { "n": "ref", "id": "reservation.Reservation" }, "where": null, "body": { "n": "path", "base": "r", "segs": [] } } }
      ]
    },

    "capabilities_by_actor": {
      "identity.Member": [
        { "capability": "identity.C_reserve", "scope": "identity.S_own" },
        { "capability": "identity.C_view_reservation", "scope": "identity.S_own" },
        { "capability": "identity.C_view_room_availability", "scope": "identity.S_all" },
        { "capability": "identity.C_cancel_reservation", "scope": "identity.S_own" }
      ],
      "identity.DeptAdmin": [
        { "capability": "identity.C_reserve", "scope": "identity.S_own" },
        { "capability": "identity.C_view_reservation", "scope": "identity.S_own" },
        { "capability": "identity.C_view_reservation", "scope": "identity.S_dept" },
        { "capability": "identity.C_view_room_availability", "scope": "identity.S_all" },
        { "capability": "identity.C_cancel_reservation", "scope": "identity.S_own" },
        { "capability": "identity.C_cancel_reservation", "scope": "identity.S_dept" },
        { "capability": "identity.C_view_subscription", "scope": "identity.S_dept" },
        { "capability": "identity.C_change_plan", "scope": "identity.S_dept" },
        { "capability": "identity.C_cancel_subscription", "scope": "identity.S_dept" },
        { "capability": "identity.C_view_invoice", "scope": "identity.S_dept" }
      ]
    },

    "transitions_by_state": {
      "reservation.L_reservation.Confirmed": [
        {
          "transition": "reservation.T_cancel",
          "to": "Cancelled",
